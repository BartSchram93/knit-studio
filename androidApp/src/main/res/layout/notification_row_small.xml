<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed notification: row badge and the start of the instruction. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/row" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/notif_badge" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="2dp" android:paddingBottom="2dp" android:textColor="#FFFFFF"
        android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/instruction" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
