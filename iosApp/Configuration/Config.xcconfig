// Knit Studio iOS build settings.
//
// BUNDLE_ID  The app's permanent identity on your iPhone. iOS keeps an app's data (your patterns,
//            photos and settings) only while updates arrive under the same identifier, so this
//            value must NEVER change. scripts/build-ios-ipa.sh and CI refuse to build if it does.
//            AltStore signs the app with your free Apple ID; it may append your team ID when it
//            registers the app, and does so identically on every update and refresh.
//
// TEAM_ID    Only needed when building and running directly from Xcode on a Mac: put your
//            Apple team ID here, or pick your team in Xcode › Signing & Capabilities.
//            Leave empty for the unsigned AltStore builds made by CI.

BUNDLE_ID=studio.knit.app
TEAM_ID=
APP_NAME=Knit Studio
